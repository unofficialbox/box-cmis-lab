# Copy to `.env` and fill in values for your Box app / CMIS connector.
# Vite only exposes variables prefixed with `VITE_` to the browser.
# Restart `bun run dev` after changing this file.

# CMIS Browser Binding service URL (proxied via Vite when using localhost:8080)
VITE_CMIS_SERVICE_URL=http://127.0.0.1:8080/cmis
VITE_CMIS_SUCCINCT=false

# Auth mode: oauth | ccg | jwt
VITE_AUTH_MODE=oauth

# Shared Box app credentials (OAuth / CCG; JWT usually comes from config JSON)
VITE_BOX_CLIENT_ID=
VITE_BOX_CLIENT_SECRET=

# OAuth 2.0
VITE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback.html

# Client Credentials Grant (CCG)
VITE_BOX_SUBJECT_TYPE=enterprise
VITE_BOX_SUBJECT_ID=

# JWT — prefer a developer config file (path relative to project root).
# Vite reads the file at startup and injects it into the connect form.
VITE_JWT_CONFIG_FILE=
# Or paste the full Box JWT config JSON here (single line or quoted multiline):
# VITE_JWT_CONFIG_JSON=
